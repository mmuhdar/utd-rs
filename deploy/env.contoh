# Salin ke .env di direktori yang sama dengan compose.yaml, lalu isi. Jangan commit .env.
UTD_VERSI=0.1.0
UTD_DOMAIN=utd.rs.lokal
UTD_DB_SANDI=ganti-dengan-sandi-acak-panjang
UTD_BACKUP_PASSPHRASE=ganti-dengan-frasa-acak-panjang-dan-simpan-di-brankas
UTD_DIR_BACKUP=/srv/utd-rs/backup
UTD_DIR_OFFSITE=/mnt/nas-cadangan/utd-rs
TZ=Asia/Jakarta
# SATUSEHAT (opsional; hanya mode UTD-RS, lihat docs/adr/0006): sandbox atau production.
UTD_SATUSEHAT_ENV=
UTD_SATUSEHAT_CLIENT_ID=
UTD_SATUSEHAT_CLIENT_SECRET=
UTD_SATUSEHAT_ORG_ID=
