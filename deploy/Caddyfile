# HTTPS untuk jaringan RS. Bawaan: sertifikat dari CA internal Caddy (pasang root CA-nya di komputer klien).
# Bila RS punya sertifikat sendiri, taruh di deploy/sertifikat/ lalu ganti baris tls menjadi:
#   tls /sertifikat/utd.crt /sertifikat/utd.key
{$UTD_DOMAIN} {
	tls internal
	encode gzip
	header Strict-Transport-Security "max-age=31536000"
	reverse_proxy app:8080
}
